{
  "name": "equal-lens-evaluator",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "VITE_STORE=emulator vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\"",
    "preview": "vite preview",
    "check": "tsc -b && oxlint && tsx --tsconfig tsconfig.app.json --import ./scripts/lib/ignore-css.mjs scripts/check-all.ts && pnpm ux && pnpm rules && pnpm e2e",
    "check:fast": "tsc -b && oxlint && tsx --tsconfig tsconfig.app.json --import ./scripts/lib/ignore-css.mjs scripts/check-all.ts",
    "rules": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:exec --only database,auth --project demo-eval 'tsx --tsconfig tsconfig.app.json scripts/rules-check.ts'",
    "length": "tsx --tsconfig tsconfig.app.json scripts/session-length.ts",
    "seed": "tsx --tsconfig tsconfig.app.json scripts/seed-emulator.ts",
    "emulators": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:start --only database,auth --project demo-eval",
    "shots": "tsx --tsconfig tsconfig.app.json scripts/shots.ts",
    "e2e": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:exec --only database,auth --project demo-eval 'tsx --tsconfig tsconfig.app.json scripts/e2e.ts'",
    "merit-reference": "tsx --tsconfig tsconfig.app.json scripts/merit-reference.ts",
    "walkthrough": "tsx --tsconfig tsconfig.app.json --import ./scripts/lib/ignore-css.mjs scripts/walkthrough.ts",
    "ux": "tsx --tsconfig tsconfig.app.json scripts/ux-audit.ts"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "4.10.3",
    "oxlint": "^1.79.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@firebase/util",
      "protobufjs"
    ]
  }
}
