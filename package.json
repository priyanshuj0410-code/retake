{
  "name": "retake",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web": "vite build && cp -R site dist/demo",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\"",
    "preview": "vite preview",
    "check": "tsc -b && oxlint && tsx --tsconfig tsconfig.app.json --import ./scripts/lib/ignore-css.mjs scripts/check-all.ts && pnpm ux && pnpm e2e && pnpm pwa",
    "check:fast": "tsc -b && oxlint && tsx --tsconfig tsconfig.app.json --import ./scripts/lib/ignore-css.mjs scripts/check-all.ts",
    "ux": "tsx --tsconfig tsconfig.app.json scripts/ux-audit.ts",
    "e2e": "tsx --tsconfig tsconfig.app.json scripts/e2e.ts",
    "pwa": "tsx --tsconfig tsconfig.app.json scripts/pwa-check.ts",
    "pwa:screens": "tsx --tsconfig tsconfig.app.json scripts/pwa/screenshots.ts",
    "shots": "tsx --tsconfig tsconfig.app.json scripts/shots.ts",
    "fonts": "tsx scripts/fonts.ts",
    "icons": "tsx scripts/icons.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@fontsource/hind": "^5.3.0",
    "@fontsource/hind-guntur": "^5.3.0",
    "@fontsource/hind-madurai": "^5.3.0",
    "@fontsource/hind-siliguri": "^5.3.0",
    "@fontsource/hind-vadodara": "^5.3.0",
    "@fontsource/sarpanch": "^5.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "4.10.3",
    "oxlint": "^1.79.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@firebase/util",
      "protobufjs"
    ]
  }
}
